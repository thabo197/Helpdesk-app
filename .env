# ── Server ─────────────────────────────
PORT=3000
NODE_ENV=development

# ── Security ────────────────────────────
# IMPORTANT: Change this to a long random string before going live
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_BEFORE_GOING_LIVE
JWT_EXPIRES_IN=8h

# ── Database ────────────────────────────
DB_PATH=./helpdesk.db

# ── File Uploads ────────────────────────
UPLOAD_DIR=./backend/uploads
MAX_FILE_SIZE_MB=10

# ── Email (set ENABLED=true and fill in credentials to activate) ──
EMAIL_ENABLED=false
EMAIL_FROM="HelpDesk <helpdesk@yourcompany.com>"
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_app_password

# ── SLA thresholds (hours per priority) ─
SLA_CRITICAL_HOURS=4
SLA_HIGH_HOURS=8
SLA_MEDIUM_HOURS=24
SLA_LOW_HOURS=72

# ── First-run admin account ─────────────
# These are used ONLY on the very first startup to create the admin account.
# After that, manage users through the app.
INIT_ADMIN_NAME=Administrator
INIT_ADMIN_EMAIL=admin@helpdesk.local
INIT_ADMIN_PASSWORD=Admin1234!
